                  "pm.test('Nace disponible', function () { pm.expect(body.disponible).to.eql(true); });",
                  "pm.test('Queda asociado al autor', function () {",
                  "  pm.expect(body.autorId).to.eql(Number(pm.collectionVariables.get('autorId')));",
                  "});",
                  "pm.collectionVariables.set('libroId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Rayuela\",\n  \"isbn\": \"TST-{{$timestamp}}\",\n  \"anioPublicacion\": 1963,\n  \"editorial\": \"Sudamericana\",\n  \"autorId\": {{autorId}}\n}"
