{
  "info": {
    "name": "Biblioteca UES - API",
    "description": "Colección de pruebas de la API del Sistema de Biblioteca UES (Spring Boot + MySQL).\n\nEjecutar con el Collection Runner en el orden de las carpetas: primero el flujo completo (crea, consulta, actualiza, presta, devuelve y elimina), luego los casos de error y por último las consultas de catálogo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "autorId", "value": "1" },
    { "key": "libroId", "value": "1" },
    { "key": "socioId", "value": "1" },
    { "key": "prestamoId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Flujo completo CRUD (ejecutar en orden)",
      "item": [
        {
          "name": "1.1 GET autores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve un arreglo', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/autores" }
        },
        {
          "name": "1.2 POST autor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve id y nombre', function () {",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body.nombre).to.eql('Julio Cortazar');",
                  "});",
                  "pm.collectionVariables.set('autorId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Julio Cortazar\",\n  \"nacionalidad\": \"Argentina\"\n}"
            },
            "url": "{{baseUrl}}/api/autores"
          }
        },
        {
          "name": "1.3 GET autor por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Es el autor creado', function () {",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('autorId')));",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/autores/{{autorId}}" }
        },
        {
          "name": "1.4 PUT autor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Nacionalidad actualizada', function () {",
                  "  pm.expect(pm.response.json().nacionalidad).to.eql('Argentino');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Julio Cortazar\",\n  \"nacionalidad\": \"Argentino\"\n}"
            },
            "url": "{{baseUrl}}/api/autores/{{autorId}}"
          }
        },
        {
          "name": "1.5 POST libro",
